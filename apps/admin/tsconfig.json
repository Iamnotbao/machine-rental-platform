{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["src/*"],
      "@machine-rental/ui": ["../../packages/ui/src/index.ts"],
      "@machine-rental/utils": ["../../packages/utils/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "../../packages/ui/src", "../../packages/utils/src"]
}
